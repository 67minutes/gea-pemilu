# Copy to .env. Never commit .env. Generate fresh secrets before deploying.
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OUTBOX_KEY=
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Optional local PostgreSQL; SQLite is only a quick UI fallback, not a concurrency test.
# DATABASE_URL=postgresql://gea:local-development-only@localhost:55432/gea
ITB_EMAIL_DOMAINS=mahasiswa.itb.ac.id,students.itb.ac.id,itb.ac.id
# file (development), gmail (committee Gmail + app password), or resend.
EMAIL_TRANSPORT=file
# With gmail, this must use the EMAIL_HOST_USER address.
DEFAULT_FROM_EMAIL=GEA Pemilu <pemilu@example.invalid>
EMAIL_HOST_USER=
# A Gmail app password (needs 2-Step Verification), never the account password.
EMAIL_HOST_PASSWORD=
# Sends per rolling 24 hours, 0 = unlimited. Gmail allows about 500; use 450.
EMAIL_DAILY_LIMIT=0
EMAIL_RESET_RESERVE=50
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Production behind Render's TLS-terminating proxy only:
TRUST_PROXY=false
# Proxies that append to X-Forwarded-For before the app (Render: 1). Used only with TRUST_PROXY=true.
TRUSTED_PROXY_HOPS=1
WEB_WORKERS=2
WEB_THREADS=2
# Voters may log in only from laptops enrolled at /committee/kiosks/. Set false only for local
# development or an isolated load-test rehearsal.
KIOSK_REQUIRED=false
# Seconds without activity before a voter session ends (a warning shows for the last 30).
KIOSK_IDLE_SECONDS=180
# How long a laptop's enrollment lasts, in seconds (60 days).
KIOSK_COOKIE_AGE=5184000
