# Copy to .env. Never commit .env. Generate fresh secrets before deploying.
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OUTBOX_KEY=
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Optional local PostgreSQL; SQLite is only a quick UI fallback, not a concurrency test.
# DATABASE_URL=postgresql://gea:local-development-only@localhost:55432/gea
ITB_EMAIL_DOMAINS=mahasiswa.itb.ac.id,students.itb.ac.id,itb.ac.id
EMAIL_TRANSPORT=file
DEFAULT_FROM_EMAIL=GEA Pemilu <pemilu@example.invalid>
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Production behind Render's TLS-terminating proxy only:
TRUST_PROXY=false
# Proxies that append to X-Forwarded-For before the app (Render: 1). Used only with TRUST_PROXY=true.
TRUSTED_PROXY_HOPS=1
WEB_WORKERS=2
WEB_THREADS=4
